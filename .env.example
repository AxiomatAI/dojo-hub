# ── DojoHub configuration ──────────────────────────────────────────────
# Copy to .env for local development. All variables are documented in docs/configuration.md.

# Public URL users reach DojoHub at (used in install commands, SSO callbacks and git URLs).
DOJO_BASE_URL=http://localhost:3000
# Random secret (>= 32 chars) for sessions and encryption of stored credentials/BYOK keys.
# Generate with: openssl rand -base64 48
DOJO_SECRET_KEY=dev-insecure-secret-change-me-0123456789abcdef
DATABASE_URL=postgres://dojohub:dojohub@localhost:5432/dojohub

# Authentication
DOJO_AUTH_LOCAL=true              # email/password login (keep enabled until SSO works)
DOJO_ALLOW_SIGNUP=false           # open self-registration (normally off)
# DOJO_BOOTSTRAP_ADMIN_EMAIL=you@acme.com   # this email becomes owner on first login
# DOJO_SETUP_TOKEN=                         # fixed setup token (otherwise one is printed in the logs)

# Storage: fs (local volume) or s3 (S3, MinIO, R2, Azure via S3 gateway…)
STORAGE_DRIVER=fs
STORAGE_PATH=./.data/blobs
# S3_BUCKET=dojohub
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=dojohub
# S3_SECRET_ACCESS_KEY=dojohub-secret
DOJO_GIT_CACHE_DIR=./.data/git

# Optional
# GITHUB_TOKEN=                    # higher rate limits / private GitHub sources
# DOJO_OSV=true                    # query OSV.dev for vulnerable dependencies (needs internet)
# DOJO_EMBEDDED_WORKER=true        # run background jobs inside the server process
LOG_LEVEL=info

# Development seed accounts (pnpm db:seed) — local development only.
DOJO_SEED_ADMIN_EMAIL=admin@dojohub.local
DOJO_SEED_ADMIN_PASSWORD=dojohub-dev-password

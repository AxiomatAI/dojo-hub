{
  "name": "@dojohub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts server",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main.ts worker",
    "build": "tsdown",
    "start": "node dist/main.js server",

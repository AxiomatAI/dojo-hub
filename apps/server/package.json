    "drizzle-orm": "^0.45.4",
    "filtrex": "^3.1.0",
    "hono": "^4.13.14",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15"

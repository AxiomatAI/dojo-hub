    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/mcp": "^1.7.14",
    "@better-auth/oauth-provider": "^1.7.14",
    "@better-auth/scim": "^1.7.14",
    "@better-auth/sso": "^1.7.14",
    "@dojohub/contract": "workspace:*",
    "@dojohub/core": "workspace:*",
    "@dojohub/db": "workspace:*",
    "@dojohub/i18n": "workspace:*",
    "@dojohub/scanner": "workspace:*",

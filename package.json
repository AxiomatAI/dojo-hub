{
  "name": "dojohub",
  "private": true,
  "description": "DojoHub — self-hosted, enterprise-grade registry for AI agent skills",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "pnpm --filter @dojohub/i18n check",
    "db:generate": "pnpm --filter @dojohub/db generate",
    "db:migrate": "pnpm --filter @dojohub/db migrate",
    "db:seed": "pnpm --filter @dojohub/server seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.0.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
